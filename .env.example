# ═══ ترتيل — متغيرات البيئة (انسخ إلى .env ولا ترفعه إلى git) ═══

# ── أساسي ──
NODE_ENV=production
PORT=3000
# في docker-compose يُبنى تلقائياً من MYSQL_PASSWORD؛ خارجه ضع رابطك الكامل:
DATABASE_URL=mysql://tarteel:CHANGE_ME@127.0.0.1:3306/tarteel
# مفتاح توقيع الجلسات — ولّده: openssl rand -base64 48
JWT_SECRET=
APP_ID=tarteel
# العنوان العام للمنصة: تُبنى منه روابط البريد وعنوان رجوع Google (لا من ترويسة Host).
PUBLIC_APP_URL=https://tarteel.example.org

# ── المصادقة: بريد وكلمة مرور داخل ترتيل ──
# المدير العام يُنشأ بالأمر فقط (لا يُمنح الدور بمطابقة البريد عند التسجيل):
#   docker compose exec app node dist/create-admin.js create-admin --email you@example.com --name "اسمك"
# السماح لأي زائر بإنشاء حساب بلا رمز (الدور يبقى user حتى استرداد كود وصول).
# مغلق افتراضياً حتى لا ينشئ أي زائر حساباً ويستهلك المساعد الذكي.
# حتى مع الإغلاق: من معه رمز دعوة معلم (TRTL-…) أو كود دخول (TRT-…) ينشئ حسابه
# بنفسه من تبويب «حساب جديد»، ويُفعَّل دوره مباشرة.
ALLOW_SIGNUP=false
# الدخول برقم الهاتف وكلمة المرور متاح دائماً بجانب البريد. الرقم المكتوب محلياً (مثل 771234567
# أو 0551234567) يُكمَّل بهذا الرمز؛ ومن يكتب +رمز الدولة أو 00 يُقبل رقمه كما هو. لا تُرسل رسائل SMS.
PHONE_DEFAULT_COUNTRY_CODE=967
# عدد الوكلاء العكسيين أمام الخادم (Caddy في docker-compose = 1). يحدد عنوان IP الحقيقي لحد المحاولات.
TRUST_PROXY_HOPS=1

# ── البريد التشغيلي (اختياري): «نسيت كلمة المرور» وتأكيد البريد ──
# ضع مفتاح مزود واحد؛ بدونه تبقى الاستعادة برابط من الإدارة فقط.
RESEND_API_KEY=
BREVO_API_KEY=
# resend | brevo (اختياري؛ يُستنتج من المفتاح المضبوط)
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@tarteel.example.org
EMAIL_FROM_NAME=ترتيل

# ── الدخول بـ Google (اختياري) ──
# Redirect URI في Google Cloud: {PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── ترويسات الأمان ──
# enforce | report-only | off
CSP_MODE=enforce
# نطاقات https إضافية مسموحة للسكربت والاتصال (مثل خادم Umami)، مفصولة بمسافة
CSP_EXTRA_SOURCES=

# ── التخزين: local | s3 ──
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
# S3 / Cloudflare R2 / Backblaze B2 / MinIO (عند STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── مساعد ترتيل الذكي (أي خدمة متوافقة مع OpenAI؛ اتركه فارغاً لتعطيله) ──
# أمثلة: https://api.openai.com/v1  |  https://openrouter.ai/api/v1  |  https://api.groq.com/openai/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# الحد اليومي لرسائل المساعد لكل مستخدم (0 = تعطيل المساعد)
AI_DAILY_LIMIT=30

# ── إشعارات المالك (اختياري): Webhook يستقبل JSON {title, content, text} ──
OWNER_NOTIFY_WEBHOOK_URL=

# ── النسخ الاحتياطي (deploy/backup.sh) ──
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# رفع اختياري إلى R2/B2/S3 (اتركه فارغاً للنسخ المحلي فقط)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=tarteel-backups/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ── docker-compose فقط ──
APP_DOMAIN=tarteel.example.org
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── السجلات والمراقبة ──
# مستوى السجلات (JSON في stdout): trace | debug | info | warn | error | silent
LOG_LEVEL=info
# اختياري: إرسال الأخطاء الداخلية إلى Sentry (يتطلب: pnpm add @sentry/node).
# SENTRY_DSN=

# ── الواجهة (تُقرأ عند البناء: pnpm build) ──
# إيقاف عامل الخدمة وإلغاء تسجيله عند المستخدمين (للطوارئ فقط).
# VITE_DISABLE_SW=true
# إحصاءات Umami اختيارية؛ لا يُحقن أي سكربت ما لم يُضبط الاثنان.
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=
