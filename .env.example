# ═══ ترتيل — متغيرات البيئة (انسخ إلى .env ولا ترفعه إلى git) ═══

# ── أساسي ──
NODE_ENV=production
PORT=3000
# في docker-compose يُبنى تلقائياً من MYSQL_PASSWORD؛ خارجه ضع رابطك الكامل:
DATABASE_URL=mysql://tarteel:CHANGE_ME@127.0.0.1:3306/tarteel
# مفتاح توقيع الجلسات — ولّده: openssl rand -base64 48
# إن نقلت نطاقاً مخصصاً كما هو، فنسخ JWT_SECRET من أسرار Manus يبقي الجلسات الحالية صالحة؛
# أما عند الانتقال من manus.space إلى نطاق جديد فسيدخل الجميع من جديد بكلمات مرورهم.
JWT_SECRET=
VITE_APP_ID=tarteel
PUBLIC_APP_URL=https://tarteel.example.org

# ── المصادقة ──
# local  = بريد وكلمة مرور داخل ترتيل (الموصى به بعد النقل)
# hybrid = محلي + زر Manus (لمرحلة الانتقال وأنت ما زلت على Manus)
# manus  = Manus OAuth فقط (السلوك القديم)
AUTH_PROVIDER=local
# بريد صاحب المنصة: يأخذ دور admin عند إنشاء حسابه (أو استخدم pnpm auth:create-admin)
OWNER_EMAIL=
# السماح بإنشاء حسابات من صفحة الدخول (الدور يبقى user حتى استرداد كود وصول)
ALLOW_SIGNUP=true

# ── التخزين: local | s3 | manus ──
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
# S3 / Cloudflare R2 / Backblaze B2 / MinIO (عند STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── مساعد ترتيل الذكي (أي خدمة متوافقة مع OpenAI؛ اتركه فارغاً لتعطيله) ──
# أمثلة: https://api.openai.com/v1  |  https://openrouter.ai/api/v1  |  https://api.groq.com/openai/v1
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── إشعارات المالك (اختياري): Webhook يستقبل JSON {title, content, text} ──
OWNER_NOTIFY_WEBHOOK_URL=

# ── Manus (فقط أثناء الانتقال؛ احذفها بعد النقل) ──
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── docker-compose فقط ──
APP_DOMAIN=tarteel.example.org
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
