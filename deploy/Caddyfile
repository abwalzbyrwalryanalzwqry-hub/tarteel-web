{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# التطبيق يضع CSP وX-Content-Type-Options وX-Frame-Options وReferrer-Policy بنفسه
		# (server/_core/securityHeaders.ts)؛ نكررها هنا بقيمة افتراضية فقط إن غابت (?).
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "SAMEORIGIN"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
